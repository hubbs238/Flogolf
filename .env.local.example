# Copy to .env.local and fill in from your Supabase project.
# Supabase dashboard: Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server side only. Powers reading a photographed scorecard.
# Create one at https://console.anthropic.com/settings/keys
# Never prefix this with NEXT_PUBLIC_ — that would ship it to browsers.
ANTHROPIC_API_KEY=sk-ant-...
